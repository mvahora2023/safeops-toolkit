{
  "schemaVersion": 1,
  "project": "safeops-toolkit",
  "synthetic": {
    "source": "demo/sample-output.json",
    "mode": "default"
  },
  "public": [
    {
      "id": "kev",
      "label": "CISA KEV Microsoft entries",
